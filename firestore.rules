rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function own() { return signedIn() && resource.data.userId == request.auth.uid; }
  function incomingOwn() { return signedIn() && request.resource.data.userId == request.auth.uid; }
  function validProperty() {
   let p = request.resource.data;
   return p.type in ['HOUSE','LAND','AGRICULTURAL_LAND','WAREHOUSE'] && p.transactionType in ['SALE','RENT'] && p.status in ['ACTIVE','SOLD','PAUSED']
    && p.direction in ['E','S','W','N','NW','SW','NE','SE'] && p.title is string && p.title.size() > 0
    && p.location.provinceCity.size() > 0 && p.location.wardCommune.size() > 0
    && p.dimensions.width is number && p.dimensions.width > 0 && p.dimensions.length is number && p.dimensions.length > 0
    && p.price.amount is number && p.price.amount > 0 && p.price.unit == 'VND'
    && p.bedrooms is int && p.bedrooms >= 0 && (!(p.type in ['LAND','AGRICULTURAL_LAND']) || p.bedrooms == 0)
    && p.media.images is list && p.media.images.size() > 0 && p.owner.name is string && p.owner.name.size() > 0
    && (p.status != 'SOLD' || (p.soldInfo.soldAt is string && p.soldInfo.actualSoldPrice is number && p.soldInfo.actualSoldPrice > 0));
  }
  match /publicShares/{id} {
   allow get: if true;
   allow list: if false;
   allow create: if incomingOwn() && request.resource.data.keys().hasOnly(['title','type','ward','province','width','length','direction','bedrooms','amount','transactionType','image','brand','phone','userId']);
   allow update: if false;
   allow delete: if own();
  }
  match /properties/{id} {
   allow read: if own();
   allow create: if incomingOwn() && validProperty();
   allow update: if own() && incomingOwn() && validProperty();
   allow delete: if own();
  }
  match /{name}/{id} {
   allow read: if name in ['customers','requirements','tasks','drafts','activities','settings','appointments','matches','templates','areas','aiLogs'] && own();
   allow create: if name in ['customers','requirements','tasks','drafts','activities','settings','appointments','matches','templates','areas','aiLogs'] && incomingOwn();
   allow update: if name in ['customers','requirements','tasks','drafts','settings','appointments','matches','templates','areas'] && own() && incomingOwn();
   allow delete: if name in ['customers','requirements','tasks','drafts','settings','appointments','matches','templates','areas'] && own();
  }
 }
}

